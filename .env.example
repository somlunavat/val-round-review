# Copy to .env (never committed) and restart `pnpm dev`.

PORT=8787

# "fixture" (default): sample matches, no network, no key.
# "live": real Riot API. Needs the three settings below.
RIOT_SOURCE=fixture

# Server-side only. Never commit a real key, never put it in the web app.
# Dev keys (developer.riotgames.com) expire every 24 h and CANNOT read match data:
# VAL-MATCH-V1 needs an approved production key. Account lookup works with either.
RIOT_API_KEY=

# Your own Riot ID. This is the only account the app will show (stand-in until RSO).
RIOT_ID=YourName#NA1

# VAL-MATCH-V1 shard: na | eu | ap | kr | latam | br
RIOT_SHARD=na
# ACCOUNT-V1 regional route: americas | europe | asia
RIOT_ACCOUNT_REGION=americas

# Optional
# MAX_MATCHES=10
# RIOT_RATE_LIMITS=20:1,100:120   # dev key limits; production keys are higher
# CACHE_PATH=.cache/matches.sqlite
# DEV_SESSION_PUUID=               # fixture mode only
