# Server port for the API (fixtures mode needs nothing else).
PORT=8787

# Data source: "fixture" (default, no network) or "live" (requires RIOT_API_KEY, not implemented yet).
RIOT_SOURCE=fixture

# Never commit a real key. Only the server reads this.
RIOT_API_KEY=

# Dev-only stand-in for a signed-in player until RSO is wired up.
DEV_SESSION_PUUID=
